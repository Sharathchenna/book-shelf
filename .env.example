# Copy to .env.local and fill in. Everything is optional: features switch on when their keys are set.

# "Ask the shelf" — Jev ranks the books (https://console.typesafe.ai/keys)
TYPESAFE_API_KEY=

# Short answers above search results, and explain/recap in the reader (Claude Haiku 5.5)
ANTHROPIC_API_KEY=

# Owner login for the private reader. SESSION_SECRET: 32+ random characters,
# e.g. `openssl rand -base64 48`.
OWNER_PASSWORD=
SESSION_SECRET=

# Cloudflare R2 for EPUBs, progress and notes. Without these, development uses ./.data.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Where the site is deployed; set in shelf.config.ts (siteUrl) for link previews.
