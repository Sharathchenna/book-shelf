<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paper behind the app before Compose draws, and the splash screen in the icon's green. -->
    <style name="Theme.Shelf" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
    </style>
    <style name="Theme.Shelf.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Shelf</item>
    </style>
    <!-- The share sheet's receiver: no window of its own, just a toast. -->
    <style name="Theme.Shelf.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
