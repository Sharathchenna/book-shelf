{
  "$schema": "node_modules/wrangler/config-schema.json",
  // worker.ts wraps the OpenNext build (`bun run deploy`) to add the nightly Goodreads sync.
  "main": "worker.ts",
  "name": "book-shelf",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Must match `name`: OpenNext calls back into the worker for some requests.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "book-shelf" }],
  // Books, clippings, and the reader's library, progress and notes. Files stay in R2.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "book-shelf",
      "database_id": "1897f70b-14fe-4b79-8b3a-bd89c0aa61e3",
      "migrations_dir": "migrations"
    }
  ],
  // Site search: embeddings of every book and clipping (Workers AI), searched by meaning.
  // Vectorize has no local simulation, so development uses the real index (in its own namespace).
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "book-shelf-search", "remote": true }],
  // The narrator's GPU voice (narrator-server/), reached through a Cloudflare Tunnel by Workers VPC.
  // Optional: without it, or when it's down, books are read aloud by the voice in the browser.
  "vpc_services": [{ "binding": "NARRATOR", "service_id": "01a1309d-e7b9-7bd2-836f-3a90e432f10f", "remote": true }],
  // Goodreads sync, nightly at 02:47 IST; the feeds, hourly (worker.ts tells them apart).
  "triggers": { "crons": ["17 21 * * *", "37 * * * *"] },
  "observability": { "enabled": true }
}
